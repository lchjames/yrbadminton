{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yrbadminton",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yrbadminton",
      "database_id": "57d61f13-2bfe-4e36-8c67-5295ab3a3a85"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ALERT_EMAIL_TO": "apswsttss@gmail.com",
    "ALERT_EMAIL_FROM": "badyrminton@lchjames.com"
  },
  "triggers": {
    "crons": [
      "5 14 * * SUN",
      "0 12 * * THU"
    ]
  },
  "observability": {
    "enabled": true
  }
}
